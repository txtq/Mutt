{
  "permissions": {
    "allow": [
      "Bash(tests/run.sh)",
      "Bash(tests/run.sh *)",
      "Bash(git status *)",
      "Bash(git diff *)",
      "Bash(git log *)",
      "Bash(git show *)",
      "Bash(git fetch *)",
      "Bash(git branch --show-current)",
      "Bash(git worktree list)",
      "Bash(wc -c /Users/edan/Mutt-notes/PROGRESS.md)",
      "Read(//Users/edan/Mutt-notes/**)",
      "Edit(//Users/edan/Mutt-notes/PROGRESS.md)",
      "Edit(//Users/edan/Mutt-notes/history/**)",
      "Bash(xcrun simctl list *)",
      "Bash(defaults read *)",
      "mcp__ccd_session_mgmt__list_sessions",
      "mcp__ccd_session_mgmt__list_events",
      "mcp__ccd_session_mgmt__get_session",
      "mcp__computer-use__app_screenshot"
    ]
  },
  "hooks": {
    "PostToolUse": [
      {
        "matcher": "Edit|Write|MultiEdit",
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/check-edit.sh",
            "timeout": 30
          }
        ]
      }
    ],
    "Stop": [
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/handoff-nudge.sh",
            "timeout": 15
          }
        ]
      }
    ]
  }
}
